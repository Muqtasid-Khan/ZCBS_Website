# Copy this file to ".env" and fill in the values. NEVER commit the real .env to GitHub.
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
# Leave empty locally (uses SQLite). On Render, paste the Internal Database URL of your PostgreSQL database.
DATABASE_URL=
# Cloudinary (image/video storage). Leave empty locally to store files in the /media folder.
CLOUDINARY_URL=
# Secret dashboard address. Change "admin/" to something only you know, e.g. zcbs-control-2026/
ADMIN_URL=admin/
CSRF_TRUSTED_ORIGINS=
MAX_IMAGE_UPLOAD_MB=8
MAX_VIDEO_UPLOAD_MB=90
